{
  "name": "ricamo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ricamo/web",
    "dev:admin": "turbo run dev --filter=@ricamo/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "create-admin-user": "node --env-file=apps/admin/.env.local scripts/create-admin-user.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@supabase/supabase-js": "^2.45.4"
  }
}
