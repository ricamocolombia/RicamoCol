# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para Server Actions / route handlers, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails transaccionales: confirmacion de pedido, etc.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@ricamo.co

# WhatsApp Business (pedidos personalizados). Numero visto publicamente en el
# Instagram @ricamo_col — confirmar con el negocio antes de usarlo en produccion.
NEXT_PUBLIC_WHATSAPP_NUMBER=573216245987

# Pasarela de pagos para el catalogo con pago en linea (definir proveedor:
# Wompi / MercadoPago / PayU)
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_PRIVATE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (opcional). ID de medicion tipo "G-XXXXXXXXXX" desde
# analytics.google.com. Sin esta variable, no se carga ningun script de
# Google — activa solo cuando se agregue el valor real.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Pixel de Meta (opcional). ID numerico desde Meta Events Manager. Sin esta
# variable, no se carga fbevents.js ni se dispara ningun evento.
NEXT_PUBLIC_META_PIXEL_ID=
